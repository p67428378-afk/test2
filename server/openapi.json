        "properties": {
          "new_password": {
            "type": "string",
            "title": "New Password"
          },
          "password_reset_session_id": {
            "type": "string",
            "title": "Password Reset Session Id"
          }
        },
        "type": "object",
        "required": [
          "new_password",
          "password_reset_session_id"
