        },
        "type": "object",
        "title": "SubmissionRequest"
      },
      "SubmissionResponse": {
        "properties": {
          "submission_id": {
            "type": "string",
            "title": "Submission Id"
          },
          "audit_ref_id": {
            "type": "string",
            "title": "Audit Ref Id"
          },
          "status": {
            "type": "string",
            "title": "Status",
            "default": "APPROVED_AND_LOGGED"
          },
          "scenario_name": {
            "type": "string",
            "title": "Scenario Name"
          },
          "selected_scenario": {
            "type": "string",
            "title": "Selected Scenario",
            "default": ""
          },
          "user_id": {
            "type": "string",
            "title": "User Id",
            "default": "usr_9921"
          },
          "total_skus_modified": {
            "type": "integer",
            "title": "Total Skus Modified"
          },
          "skus_modified_count": {
            "type": "integer",
            "title": "Skus Modified Count",
            "default": 0
          },
          "guardrails_status": {
            "type": "string",
            "title": "Guardrails Status",
            "default": "PASSED"
          },
          "submitted_at": {
            "type": "string",
            "title": "Submitted At"
          },
          "timestamp_utc": {
            "type": "string",
            "title": "Timestamp Utc",
            "default": ""
          }
        },
        "type": "object",
        "required": [
          "submission_id",
          "audit_ref_id",
          "scenario_name",
          "total_skus_modified",
          "submitted_at"
        ],
        "title": "SubmissionResponse"
      },
      "TabItem": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "label": {
            "type": "string",
            "title": "Label"
          },
          "icon": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Icon"
          },
          "active": {
            "type": "boolean",
            "title": "Active",
            "default": true
          }
        },
        "type": "object",
        "required": [
          "id",
          "label"
        ],
        "title": "TabItem"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    }
  }
}