  "requirements": {
    "summary": "Build a Food Donation Management System where restaurants donate surplus food, NGOs accept requests, volunteers deliver donations, and food freshness is monitored.",
    "acceptance_criteria": [
      "Role-Based Access Control and Multi-Portal Authentication",
      "Surplus Food Posting & Real-Time Freshness Monitoring",
      "NGO Claim Allocation and Request Handling",
      "Volunteer Dispatch, Delivery Routing, and Digital Proof of Delivery",
      "Admin Oversight, Waste Analytics, and Audit Logs"
    ],
    "is_fullstack": true,
    "is_backend_only": false,
    "notes": ""
  },
