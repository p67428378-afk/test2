# Database connection URL (defaults to SQLite for local development)
DATABASE_URL=sqlite:////tmp/mbbs_learning.db

# Secret key for signing student JWT session tokens
JWT_SECRET_KEY=mbbs-digital-learning-secret-key-2026

# Comma-separated list of allowed CORS origins for client frontend development
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# Application Environment Mode
ENVIRONMENT=development
TESTING=false
