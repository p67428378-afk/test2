  "components": {
    "schemas": {
      "AttendanceMarkRequest": {
        "properties": {
          "class_id": {
            "type": "string",
            "format": "uuid",
            "title": "Class Id"
          },
          "date": {
            "type": "string",
            "format": "date",
            "title": "Date"
          },
          "records": {
            "items": {
              "$ref": "#/components/schemas/AttendanceRecordItem"
            },
            "type": "array",
            "title": "Records"
          }
        },
        "type": "object",
        "required": [
          "class_id",
          "date",
          "records"
        ],
        "title": "AttendanceMarkRequest"
      },
      "AttendanceMarkResponse": {
        "properties": {
          "message": {
            "type": "string",
            "title": "Message"
          },
          "processed_count": {
            "type": "integer",
            "title": "Processed Count"
          }
        },
        "type": "object",
        "required": [
          "message",
          "processed_count"
        ],
        "title": "AttendanceMarkResponse"
      },
      "AttendanceRecordItem": {
        "properties": {
          "student_id": {
            "type": "string",
            "format": "uuid",
            "title": "Student Id"
          },
          "status": {
            "type": "string",
            "pattern": "^(Present|Absent|Late)$",
            "title": "Status"
          }
        },
        "type": "object",
        "required": [
          "student_id",
          "status"
        ],
        "title": "AttendanceRecordItem"
      },
      "AttendanceRecordResponse": {
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "title": "Id"
          },
          "student_id": {
            "type": "string",
            "format": "uuid",
            "title": "Student Id"
          },
          "student_name": {
            "type": "string",
            "title": "Student Name"
          },
          "class_id": {
            "type": "string",
            "format": "uuid",
            "title": "Class Id"
          },
          "status": {
            "type": "string",
            "title": "Status"
          },
          "roll_no": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Roll No"
          },
          "timestamp": {
            "type": "string",
            "format": "date-time",
            "title": "Timestamp"
          },
          "last_notification": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Last Notification"
          }
        },
        "type": "object",
        "required": [
          "id",
          "student_id",
          "student_name",
          "class_id",
          "status",
          "timestamp"
        ],
        "title": "AttendanceRecordResponse"
      },
      "CalendarItem": {
        "properties": {
          "date": {
            "type": "string",
            "format": "date",
            "title": "Date"
          },
          "status": {
            "type": "string",
            "title": "Status"
          }
        },
        "type": "object",
        "required": [
          "date",
          "status"
        ],
        "title": "CalendarItem"
      },
      "ClassResponse": {
        "properties": {
          "name": {
            "type": "string",
            "title": "Name"
          },
          "grade": {
            "type": "string",
            "title": "Grade"
          },
          "teacher_id": {
            "type": "string",
            "format": "uuid",
            "title": "Teacher Id"
          },
          "id": {
            "type": "string",
            "format": "uuid",
            "title": "Id"
          },
          "created_at": {
            "type": "string",
            "format": "date-time",
            "title": "Created At"
