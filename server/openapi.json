            "title": "Id"
          },
          "account_number": {
            "type": "string",
            "title": "Account Number"
          },
          "balance": {
            "type": "number",
            "title": "Balance"
          },
          "currency": {
            "type": "string",
            "title": "Currency"
          }
        },
        "type": "object",
        "required": [
          "id",
          "account_number",
          "balance",
          "currency"
        ],
        "title": "AccountResponse"
      },
      "FDCreateRequest": {
        "properties": {
          "product_id": {
            "type": "string",
