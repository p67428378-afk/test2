      "post": {
        "tags": [
          "roundups"
        ],
        "summary": "Trigger Daily Job",
        "description": "Daily scheduled job trigger.\nSums up all 'Pending' round-up amounts from a 24-hour period for enabled users\nand executes a single investment transaction per user.\nAlso updates milestone achievements.",
