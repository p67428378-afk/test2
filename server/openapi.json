  "components": {
    "schemas": {
      "CodebaseAnalysisRunRequest": {
        "properties": {
          "issue_key": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Issue Key",
            "default": "SCRUM-231"
          },
          "repo_url": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Repo Url",
            "default": "https://github.com/p67428378-afk/test2"
          },
          "branch_name": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Branch Name",
            "default": "staging/ISSUE-SCRUM-231"
          }
        },
        "type": "object",
        "title": "CodebaseAnalysisRunRequest"
      },
      "CodebaseAnalysisRunResponse": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "issue_key": {
            "type": "string",
            "title": "Issue Key"
          },
          "repo_url": {
            "type": "string",
            "title": "Repo Url"
          },
          "branch_name": {
            "type": "string",
            "title": "Branch Name"
          },
          "status": {
            "type": "string",
            "title": "Status"
          },
          "report_gcs_path": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Report Gcs Path"
          },
          "triggered_at": {
            "type": "string",
            "format": "date-time",
            "title": "Triggered At"
          },
          "completed_at": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ],
            "title": "Completed At"
          }
        },
        "type": "object",
        "required": [
          "id",
          "issue_key",
          "repo_url",
          "branch_name",
          "status",
          "triggered_at"
        ],
        "title": "CodebaseAnalysisRunResponse"
      },
      "CodebaseReport": {
        "properties": {
          "issue_key": {
            "type": "string",
            "title": "Issue Key"
          },
          "repo_url": {
            "type": "string",
            "title": "Repo Url"
          },
          "branch_analyzed": {
            "type": "string",
            "title": "Branch Analyzed"
          },
          "analyzed_at": {
            "type": "string",
            "title": "Analyzed At"
          },
          "status": {
            "type": "string",
            "title": "Status"
          },
          "tech_stack": {
            "additionalProperties": true,
            "type": "object",
            "title": "Tech Stack"
          },
          "metrics": {
            "additionalProperties": true,
            "type": "object",
            "title": "Metrics"
          }
        },
        "type": "object",
        "required": [
          "issue_key",
          "repo_url",
          "branch_analyzed",
          "analyzed_at",
          "status",
          "tech_stack",
          "metrics"
        ],
        "title": "CodebaseReport"
      },
      "ExportRequest": {
        "properties": {
          "recommendation_id": {
            "type": "string",
            "minLength": 1,
            "title": "Recommendation Id"
          },
          "export_format": {
            "type": "string",
            "title": "Export Format",
            "description": "Export format: json, pdf, or link",
            "default": "json"
          },
          "include_cost_summary": {
            "anyOf": [
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ],
            "title": "Include Cost Summary",
            "default": true
          }
        },
        "type": "object",
        "required": [
          "recommendation_id"
        ],
        "title": "ExportRequest"
      },
      "ExportResponse": {
        "properties": {
          "export_id": {
            "type": "string",
            "title": "Export Id"
          },
          "recommendation_id": {
            "type": "string",
            "title": "Recommendation Id"
          },
          "file_name": {
            "type": "string",
            "title": "File Name"
          },
          "mime_type": {
            "type": "string",
            "title": "Mime Type"
          },
          "content_base64": {
            "type": "string",
            "title": "Content Base64"
          },
          "share_url": {
            "type": "string",
            "title": "Share Url"
          }
        },
        "type": "object",
        "required": [
          "export_id",
          "recommendation_id",
          "file_name",
          "mime_type",
          "content_base64",
          "share_url"
        ],
        "title": "ExportResponse"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "RecommendationItemResponse": {
        "properties": {
          "title": {
            "type": "string",
            "title": "Title"
          },
          "category": {
            "type": "string",
            "title": "Category"
          },
          "estimated_cost": {
            "type": "number",
            "title": "Estimated Cost",
            "default": 0.0
          },
          "location": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Location"
          },
          "duration": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Duration"
          },
          "description": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Description"
          },
          "id": {
            "type": "string",
            "title": "Id"
          },
          "recommendation_id": {
            "type": "string",
            "title": "Recommendation Id"
          },
          "created_at": {
            "type": "string",
            "format": "date-time",
            "title": "Created At"
          }
        },
        "type": "object",
        "required": [
          "title",
          "category",
          "id",
          "recommendation_id",
          "created_at"
        ],
        "title": "RecommendationItemResponse"
      },
      "RecommendationResponse": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "request_id": {
            "type": "string",
            "title": "Request Id"
          },
          "is_fallback": {
            "type": "boolean",
            "title": "Is Fallback"
          },
          "created_at": {
            "type": "string",
            "format": "date-time",
            "title": "Created At"
          },
          "request": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/TravelRequestResponse"
              },
              {
                "type": "null"
              }
            ]
          },
          "items": {
            "items": {
              "$ref": "#/components/schemas/RecommendationItemResponse"
            },
            "type": "array",
            "title": "Items"
          },
          "total_estimated_cost": {
            "type": "number",
            "title": "Total Estimated Cost",
            "default": 0.0
          }
        },
        "type": "object",
        "required": [
          "id",
          "request_id",
          "is_fallback",
          "created_at"
        ],
        "title": "RecommendationResponse"
      },
      "TravelRequestCreate": {
        "properties": {
          "destination": {
            "type": "string",
            "minLength": 1,
            "title": "Destination",
            "description": "Target destination city/country"
          },
          "budget": {
            "type": "number",
            "exclusiveMinimum": 0.0,
            "title": "Budget",
            "description": "Numerical budget constraint"
          },
          "currency": {
            "type": "string",
            "title": "Currency",
            "description": "Currency code (e.g. USD, EUR, JPY)",
            "default": "USD"
          },
          "interests": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Interests",
            "description": "List of interest categories"
          }
        },
        "type": "object",
        "required": [
          "destination",
          "budget"
        ],
        "title": "TravelRequestCreate"
      },
      "TravelRequestResponse": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "destination": {
            "type": "string",
            "title": "Destination"
          },
          "budget": {
            "type": "number",
            "title": "Budget"
          },
          "currency": {
            "type": "string",
            "title": "Currency"
          },
          "interests": {
            "anyOf": [
              {
                "items": {
                  "type": "string"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "title": "Interests"
          },
          "created_at": {
            "type": "string",
            "format": "date-time",
            "title": "Created At"
          }
        },
        "type": "object",
        "required": [
          "id",
          "destination",
          "budget",
          "currency",
          "created_at"
        ],
        "title": "TravelRequestResponse"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    }
  }
}