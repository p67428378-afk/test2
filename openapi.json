            "title": "Selected Scenario"
          },
          "user_id": {
            "type": "string",
            "title": "User Id",
            "default": "USR-CM-882"
          },
          "guardrails_override": {
            "type": "boolean",
            "title": "Guardrails Override",
            "default": false
