  "components": {
    "schemas": {
      "DecisionRequest": {
        "properties": {
          "scenario_name": {
            "type": "string",
            "title": "Scenario Name"
          },
          "sku_actions": {
            "items": {
              "$ref": "#/components/schemas/SKUAction"
            },
            "type": "array",
            "title": "Sku Actions"
          }
        },
        "type": "object",
        "required": [
          "scenario_name",
          "sku_actions"
        ],
        "title": "DecisionRequest"
      },
      "DecisionResponse": {
        "properties": {
          "status": {
            "type": "string",
            "title": "Status"
          },
          "audit_trail_id": {
            "type": "string",
            "format": "uuid",
            "title": "Audit Trail Id"
          },
          "submitted_at": {
            "type": "string",
            "format": "date-time",
            "title": "Submitted At"
          }
        },
        "type": "object",
        "required": [
          "status",
          "audit_trail_id",
          "submitted_at"
        ],
        "title": "DecisionResponse"
      },
      "GuardrailCheck": {
        "properties": {
          "name": {
            "type": "string",
            "title": "Name"
          },
          "passed": {
            "type": "boolean",
            "title": "Passed"
          },
          "details": {
            "type": "string",
            "title": "Details"
          }
        },
        "type": "object",
        "required": [
          "name",
          "passed",
          "details"
        ],
        "title": "GuardrailCheck"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "KPIResponse": {
        "properties": {
          "sales_per_linear_ft": {
            "type": "number",
            "title": "Sales Per Linear Ft"
          },
          "private_brand_percentage": {
            "type": "number",
            "title": "Private Brand Percentage"
          },
          "in_stock_rate": {
            "type": "number",
            "title": "In Stock Rate"
          },
          "shelf_capacity_utilized": {
            "type": "number",
            "title": "Shelf Capacity Utilized"
          },
          "sales_trend_percentage": {
            "type": "number",
            "title": "Sales Trend Percentage"
          }
        },
        "type": "object",
        "required": [
          "sales_per_linear_ft",
          "private_brand_percentage",
          "in_stock_rate",
          "shelf_capacity_utilized",
          "sales_trend_percentage"
        ],
        "title": "KPIResponse"
      },
      "OTPVerifyRequest": {
        "properties": {
          "otp_code": {
            "type": "string",
            "title": "Otp Code"
          },
          "otp_session_id": {
            "type": "string",
            "title": "Otp Session Id"
          }
        },
        "type": "object",
        "required": [
          "otp_code",
          "otp_session_id"
        ],
        "title": "OTPVerifyRequest"
      },
      "OTPVerifyResponse": {
        "properties": {
          "security_question_session_id": {
            "type": "string",
            "title": "Security Question Session Id"
          }
        },
        "type": "object",
        "required": [
          "security_question_session_id"
        ],
        "title": "OTPVerifyResponse"
      },
      "PasswordResetInitiateRequest": {
        "properties": {
          "login_id": {
            "type": "string",
            "title": "Login Id"
          },
          "mobile_number": {
            "type": "string",
            "title": "Mobile Number"
          }
        },
        "type": "object",
        "required": [
          "login_id",
          "mobile_number"
        ],
        "title": "PasswordResetInitiateRequest"
      },
      "PasswordResetInitiateResponse": {
        "properties": {
          "otp_session_id": {
            "type": "string",
            "title": "Otp Session Id"
          },
          "security_question": {
            "type": "string",
            "title": "Security Question"
          }
        },
        "type": "object",
        "required": [
          "otp_session_id",
          "security_question"
        ],
        "title": "PasswordResetInitiateResponse"
      },
      "SKUAction": {
        "properties": {
          "action": {
            "type": "string",
            "title": "Action",
            "description": "ADD | REMOVE | SWAP | KEEP"
          },
          "product_name": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Product Name"
          },
          "sku_id": {
            "type": "string",
            "title": "Sku Id"
          }
        },
        "type": "object",
        "required": [
          "action",
          "sku_id"
        ],
        "title": "SKUAction"
      },
      "SKUResponse": {
        "properties": {
          "sku_id": {
            "type": "string",
            "title": "Sku Id"
          },
          "product_name": {
            "type": "string",
            "title": "Product Name"
          },
          "current_sales": {
            "type": "number",
            "title": "Current Sales"
          },
          "sales_growth": {
            "type": "number",
            "title": "Sales Growth"
          },
          "is_private_brand": {
            "type": "boolean",
            "title": "Is Private Brand"
          },
          "status": {
            "type": "string",
            "title": "Status"
          }
        },
        "type": "object",
        "required": [
          "sku_id",
          "product_name",
          "current_sales",
          "sales_growth",
          "is_private_brand",
          "status"
        ],
        "title": "SKUResponse"
      },
      "ScenarioRequest": {
        "properties": {
          "scenario_name": {
            "type": "string",
            "title": "Scenario Name",
            "description": "Conservative | Balanced | Aggressive"
          }
        },
        "type": "object",
        "required": [
          "scenario_name"
        ],
        "title": "ScenarioRequest"
      },
      "ScenarioResponse": {
        "properties": {
          "scenario_name": {
            "type": "string",
            "title": "Scenario Name"
          },
          "projected_sales_impact": {
            "type": "number",
            "title": "Projected Sales Impact"
          },
          "projected_pb_impact": {
            "type": "number",
            "title": "Projected Pb Impact"
          },
          "sku_actions": {
            "items": {
              "$ref": "#/components/schemas/SKUAction"
            },
            "type": "array",
            "title": "Sku Actions"
          },
          "guardrails": {
            "items": {
              "$ref": "#/components/schemas/GuardrailCheck"
            },
            "type": "array",
            "title": "Guardrails"
          }
        },
        "type": "object",
        "required": [
          "scenario_name",
          "projected_sales_impact",
          "projected_pb_impact",
          "sku_actions",
          "guardrails"
        ],
        "title": "ScenarioResponse"
      },
      "SecurityQuestionVerifyRequest": {
        "properties": {
          "answer": {
            "type": "string",
            "title": "Answer"
          },
          "security_question_session_id": {
            "type": "string",
            "title": "Security Question Session Id"
          }
        },
        "type": "object",
        "required": [
          "answer",
          "security_question_session_id"
        ],
        "title": "SecurityQuestionVerifyRequest"
      },
      "SecurityQuestionVerifyResponse": {
        "properties": {
          "password_reset_session_id": {
            "type": "string",
            "title": "Password Reset Session Id"
          }
        },
        "type": "object",
        "required": [
          "password_reset_session_id"
        ],
        "title": "SecurityQuestionVerifyResponse"
      },
      "SetNewPasswordRequest": {
        "properties": {
          "new_password": {
            "type": "string",
            "title": "New Password"
          },
          "password_reset_session_id": {
            "type": "string",
            "title": "Password Reset Session Id"
          }
        },
        "type": "object",
        "required": [
          "new_password",
          "password_reset_session_id"
        ],
        "title": "SetNewPasswordRequest"
      },
      "SetNewPasswordResponse": {
        "properties": {
          "status": {
            "type": "string",
            "title": "Status"
          },
          "login_link": {
            "type": "string",
            "title": "Login Link"
          }
        },
        "type": "object",
        "required": [
          "status",
          "login_link"
        ],
        "title": "SetNewPasswordResponse"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    }
  }
}