# Database connection string (PostgreSQL for production, SQLite for local)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/chatgpt

# Secret key for JWT token signing (if auth is added later)
JWT_SECRET_KEY=dev-secret-change-in-production

# Comma-separated list of allowed CORS origins
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# OpenAI API Key for real streaming (optional, falls back to mock streaming if unset)
OPENAI_API_KEY=your-openai-api-key-here
