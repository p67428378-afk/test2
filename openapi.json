        "properties": {
          "total_skus": {
            "type": "integer",
            "title": "Total Skus"
          },
          "skus": {
            "items": {
              "$ref": "#/components/schemas/SKUItemResponse"
            },
            "type": "array",
            "title": "Skus"
          }
        },
        "type": "object",
        "required": [
          "total_skus",
          "skus"
        ],
        "title": "SKUListResponse"
      },
      "ScenarioListResponse": {
        "properties": {
          "cluster_id": {
            "type": "string",
            "title": "Cluster Id",
            "default": "STV-CLUSTER-01"
          },
          "default_scenario": {
            "type": "string",
            "title": "Default Scenario",
            "default": "Balanced"
          },
          "scenarios": {
            "items": {
              "$ref": "#/components/schemas/ScenarioResponse"
            },
            "type": "array",
            "title": "Scenarios"
          }
        },
        "type": "object",
        "required": [
          "scenarios"
        ],
        "title": "ScenarioListResponse"
      },
      "ScenarioResponse": {
        "properties": {
          "scenario_id": {
            "type": "string",
            "title": "Scenario Id"
          },
          "name": {
            "type": "string",
            "title": "Name"
          },
          "scenario_name": {
            "type": "string",
            "title": "Scenario Name",
            "default": ""
          },
          "projected_sales_lift_pct": {
            "type": "number",
            "title": "Projected Sales Lift Pct"
          },
          "projected_private_brand_pct": {
            "type": "number",
            "title": "Projected Private Brand Pct"
          },
          "private_brand_mix_pct": {
            "type": "number",
            "title": "Private Brand Mix Pct",
            "default": 0.0
          },
          "shelf_capacity_impact_pct": {
            "type": "number",
            "title": "Shelf Capacity Impact Pct"
          },
          "action_summary": {
            "$ref": "#/components/schemas/ActionSummary"
          },
          "actions_breakdown": {
            "$ref": "#/components/schemas/ActionSummary",
            "default": {
              "GROW": 0,
              "MAINTAIN": 0,
              "SWAP": 0,
              "REDUCE": 0
            }
