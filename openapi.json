            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Spot facility type filter",
              "title": "Spot Type"
            },
            "description": "Spot facility type filter"
          },
          {
            "name": "category",
            "in": "query",
