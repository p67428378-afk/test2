{
  "openapi": "3.1.0",
  "info": {
    "title": "KeyCraft Password Generator API",
    "description": "Cryptographically secure password and key generation service",
    "version": "1.0.0"
  },
  "paths": {
    "/api/v1/passwords/generate": {
      "post": {
        "tags": [
          "passwords"
        ],
        "summary": "Generate Cryptographically Secure Password",
        "description": "Generates a cryptographically random password according to requested length and complexity criteria.",
        "operationId": "generate_password_api_v1_passwords_generate_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PasswordGenerateRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PasswordGenerateResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/health": {
      "get": {
        "tags": [
          "passwords"
        ],
        "summary": "Service Health Check",
        "description": "Returns operational status of the service.",
        "operationId": "health_check_api_v1_health_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthCheckResponse"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "HealthCheckResponse": {
        "properties": {
          "status": {
            "type": "string",
            "title": "Status"
          },
          "service": {
            "type": "string",
            "title": "Service"
          },
          "timestamp": {
            "type": "string",
            "title": "Timestamp"
          }
        },
        "type": "object",
        "required": [
          "status",
          "service",
          "timestamp"
        ],
        "title": "HealthCheckResponse"
      },
      "PasswordGenerateRequest": {
        "properties": {
          "length": {
            "type": "integer",
            "maximum": 128.0,
            "minimum": 8.0,
            "title": "Length",
            "description": "Length of the password (8 to 128 characters)",
            "default": 16
          },
          "include_uppercase": {
            "type": "boolean",
            "title": "Include Uppercase",
            "description": "Include uppercase letters (A-Z)",
            "default": true
          },
          "include_lowercase": {
            "type": "boolean",
            "title": "Include Lowercase",
            "description": "Include lowercase letters (a-z)",
            "default": true
          },
          "include_digits": {
            "type": "boolean",
            "title": "Include Digits",
            "description": "Include numbers (0-9)",
            "default": true
          },
          "include_symbols": {
            "type": "boolean",
            "title": "Include Symbols",
            "description": "Include special symbols",
            "default": true
          }
        },
        "type": "object",
        "title": "PasswordGenerateRequest"
      },
      "PasswordGenerateResponse": {
        "properties": {
          "password": {
            "type": "string",
            "title": "Password"
          },
          "length": {
            "type": "integer",
            "title": "Length"
          },
          "entropy_bits": {
            "type": "number",
            "title": "Entropy Bits"
          },
          "strength": {
            "type": "string",
            "title": "Strength"
          },
          "generated_at": {
            "type": "string",
            "title": "Generated At"
          }
        },
        "type": "object",
        "required": [
          "password",
          "length",
          "entropy_bits",
          "strength",
          "generated_at"
        ],
        "title": "PasswordGenerateResponse"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    }
  }
}