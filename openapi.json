        },
        "type": "object",
        "required": [
          "scenario_id",
          "name",
          "projected_sales_lift_pct",
          "projected_private_brand_pct",
          "shelf_capacity_impact_pct",
          "action_summary"
        ],
        "title": "ScenarioResponse"
      },
      "SubmissionRequest": {
        "properties": {
          "cluster_id": {
            "type": "string",
            "title": "Cluster Id",
            "default": "STV-CLUSTER-01"
          },
          "category": {
            "type": "string",
            "title": "Category",
            "default": "Snacks"
          },
          "scenario_name": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Scenario Name"
          },
          "selected_scenario": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
