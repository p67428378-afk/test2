                {
                  "type": "null"
                }
              ],
              "description": "User or target latitude",
              "title": "Lat"
            },
            "description": "User or target latitude"
          },
          {
            "name": "lng",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "number"
                },
                {
                  "type": "null"
                }
              ],
              "description": "User or target longitude",
              "title": "Lng"
            },
            "description": "User or target longitude"
          },
          {
            "name": "address",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Search address (e.g., '123 Main St')",
              "title": "Address"
            },
            "description": "Search address (e.g., '123 Main St')"
          },
          {
            "name": "radius_km",
            "in": "query",
            "required": false,
            "schema": {
              "type": "number",
              "maximum": 100.0,
              "minimum": 0.1,
              "description": "Search radius in kilometers",
              "default": 5.0,
              "title": "Radius Km"
            },
            "description": "Search radius in kilometers"
          },
          {
            "name": "max_rate",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "number",
                  "minimum": 0.0
                },
                {
                  "type": "null"
                }
              ],
              "description": "Filter spots at or below this hourly rate",
              "title": "Max Rate"
            },
            "description": "Filter spots at or below this hourly rate"
          },
          {
            "name": "spot_type",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Filter by spot type ('covered', 'open_lot', 'street', 'garage')",
              "title": "Spot Type"
            },
            "description": "Filter by spot type ('covered', 'open_lot', 'street', 'garage')"
          },
          {
            "name": "has_ev_charging",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "boolean"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Filter by EV charging availability",
              "title": "Has Ev Charging"
            },
            "description": "Filter by EV charging availability"
          },
          {
            "name": "status",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Filter by spot status ('AVAILABLE', 'OCCUPIED')",
              "title": "Status"
            },
            "description": "Filter by spot status ('AVAILABLE', 'OCCUPIED')"
          },
          {
            "name": "sort_by",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Sort by 'distance', 'price'/'rate', 'name', or 'capacity'",
              "default": "distance",
              "title": "Sort By"
            },
            "description": "Sort by 'distance', 'price'/'rate', 'name', or 'capacity'"
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ParkingSearchResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
