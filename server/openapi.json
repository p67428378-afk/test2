          "interest_rate": {
            "type": "number",
            "title": "Interest Rate"
          },
          "maturity_amount": {
            "type": "number",
            "title": "Maturity Amount"
          },
          "maturity_date": {
            "type": "string",
            "title": "Maturity Date"
          },
          "principal_amount": {
            "type": "number",
            "title": "Principal Amount"
          },
          "status": {
            "type": "string",
            "title": "Status"
          },
          "tenure_months": {
            "type": "integer",
            "title": "Tenure Months"
          }
