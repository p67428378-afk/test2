        "properties": {
          "sku_id": {
            "type": "string",
            "title": "Sku Id"
          },
          "product_name": {
            "type": "string",
            "title": "Product Name"
          },
          "sub_category": {
            "type": "string",
            "title": "Sub Category"
          },
          "sales_volume_weekly": {
            "type": "number",
            "title": "Sales Volume Weekly"
          },
          "sales_volume": {
            "type": "number",
            "title": "Sales Volume",
            "default": 0.0
          },
          "margin_pct": {
            "type": "number",
            "title": "Margin Pct"
          },
          "linear_space_ft": {
            "type": "number",
            "title": "Linear Space Ft"
          },
          "is_private_brand": {
            "type": "boolean",
            "title": "Is Private Brand"
          },
          "private_brand_indicator": {
            "type": "boolean",
            "title": "Private Brand Indicator",
            "default": false
          },
          "status_badge": {
            "type": "string",
            "title": "Status Badge"
          }
        },
        "type": "object",
        "required": [
          "sku_id",
          "product_name",
          "sub_category",
          "sales_volume_weekly",
          "margin_pct",
          "linear_space_ft",
          "is_private_brand",
          "status_badge"
        ],
        "title": "SKUItemResponse"
      },
