          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/GuardrailItem"
                  },
                  "type": "array",
                  "title": "Response Get Guardrails Api V1 Guardrails  Get"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/guardrails": {
      "get": {
        "tags": [
          "guardrails"
        ],
        "summary": "Get Guardrails",
        "operationId": "get_guardrails_api_v1_guardrails_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/GuardrailItem"
                  },
                  "type": "array",
                  "title": "Response Get Guardrails Api V1 Guardrails Get"
                }
              }
            }
          }
        }
      }
