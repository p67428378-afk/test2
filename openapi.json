{
  "openapi": "3.1.0",
  "info": {
    "title": "DG Cluster Assortment Advisor API",
    "description": "Decision-support API for Dollar General Snacks cluster assortment management",
    "version": "1.0.0"
  },
  "paths": {
    "/api/v1/assortment/kpis": {
      "get": {
        "tags": [
          "Assortment Advisor"
        ],
        "summary": "Get Cluster Kpis",
        "operationId": "get_cluster_kpis_api_v1_assortment_kpis_get",
        "parameters": [
          {
            "name": "cluster_id",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "description": "Cluster code identifier",
              "default": "small-town-value",
              "title": "Cluster Id"
            },
            "description": "Cluster code identifier"
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ClusterKPIsResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/assortment/skus": {
      "get": {
        "tags": [
          "Assortment Advisor"
        ],
        "summary": "Get Cluster Skus",
        "operationId": "get_cluster_skus_api_v1_assortment_skus_get",
        "parameters": [
          {
            "name": "cluster_id",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "description": "Cluster code identifier",
              "default": "small-town-value",
              "title": "Cluster Id"
            },
            "description": "Cluster code identifier"
          },
          {
            "name": "category",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Category filter e.g. Snacks",
              "title": "Category"
            },
            "description": "Category filter e.g. Snacks"
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SKUListResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/assortment/scenarios": {
      "get": {
        "tags": [
          "Assortment Advisor"
        ],
        "summary": "Get Scenarios",
        "operationId": "get_scenarios_api_v1_assortment_scenarios_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ScenariosResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/assortment/submit": {
      "post": {
        "tags": [
          "Assortment Advisor"
        ],
        "summary": "Submit Recommendation",
        "operationId": "submit_recommendation_api_v1_assortment_submit_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SubmitRecommendationRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SubmitRecommendationResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/": {
      "get": {
        "summary": "Read Root",
        "operationId": "read_root__get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          }
        }
      }
    },
    "/health": {
      "get": {
        "summary": "Health Check",
        "operationId": "health_check_health_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "ClusterKPIsResponse": {
        "properties": {
          "cluster_id": {
            "type": "string",
            "title": "Cluster Id"
          },
          "sales_per_linear_ft": {
            "type": "number",
            "title": "Sales Per Linear Ft"
          },
          "private_brand_share_pct": {
            "type": "number",
            "title": "Private Brand Share Pct"
          },
          "instock_rate_pct": {
            "type": "number",
            "title": "Instock Rate Pct"
          },
          "shelf_capacity_utilization_pct": {
            "type": "number",
            "title": "Shelf Capacity Utilization Pct"
          },
          "last_updated": {
            "type": "string",
            "title": "Last Updated"
          }
        },
        "type": "object",
        "required": [
          "cluster_id",
          "sales_per_linear_ft",
          "private_brand_share_pct",
          "instock_rate_pct",
          "shelf_capacity_utilization_pct",
          "last_updated"
        ],
        "title": "ClusterKPIsResponse"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "SKUItem": {
        "properties": {
          "sku_id": {
            "type": "string",
            "title": "Sku Id"
          },
          "name": {
            "type": "string",
            "title": "Name"
          },
          "category": {
            "type": "string",
            "title": "Category"
          },
          "velocity_units_per_wk": {
            "type": "number",
            "title": "Velocity Units Per Wk"
          },
          "margin_pct": {
            "type": "number",
            "title": "Margin Pct"
          },
          "linear_ft_space": {
            "type": "number",
            "title": "Linear Ft Space"
          },
          "is_private_brand": {
            "type": "boolean",
            "title": "Is Private Brand"
          },
          "status_badge": {
            "type": "string",
            "title": "Status Badge"
          }
        },
        "type": "object",
        "required": [
          "sku_id",
          "name",
          "category",
          "velocity_units_per_wk",
          "margin_pct",
          "linear_ft_space",
          "is_private_brand",
          "status_badge"
        ],
        "title": "SKUItem"
      },
      "SKUListResponse": {
        "properties": {
          "total_count": {
            "type": "integer",
            "title": "Total Count"
          },
          "skus": {
            "items": {
              "$ref": "#/components/schemas/SKUItem"
            },
            "type": "array",
            "title": "Skus"
          }
        },
        "type": "object",
        "required": [
          "total_count",
          "skus"
        ],
        "title": "SKUListResponse"
      },
      "ScenarioItem": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "label": {
            "type": "string",
            "title": "Label"
          },
          "projected_sales_delta_pct": {
            "type": "number",
            "title": "Projected Sales Delta Pct"
          },
          "projected_pb_share_pct": {
            "type": "number",
            "title": "Projected Pb Share Pct"
          },
          "shelf_capacity_impact_pct": {
            "type": "number",
            "title": "Shelf Capacity Impact Pct"
          }
        },
        "type": "object",
        "required": [
          "id",
          "label",
          "projected_sales_delta_pct",
          "projected_pb_share_pct",
          "shelf_capacity_impact_pct"
        ],
        "title": "ScenarioItem"
      },
      "ScenariosResponse": {
        "properties": {
          "default_selected": {
            "type": "string",
            "title": "Default Selected"
          },
          "scenarios": {
            "items": {
              "$ref": "#/components/schemas/ScenarioItem"
            },
            "type": "array",
            "title": "Scenarios"
          }
        },
        "type": "object",
        "required": [
          "default_selected",
          "scenarios"
        ],
        "title": "ScenariosResponse"
      },
      "SubmitRecommendationRequest": {
        "properties": {
          "cluster_id": {
            "type": "string",
            "title": "Cluster Id"
          },
          "scenario_id": {
            "type": "string",
            "title": "Scenario Id"
          },
          "manager_id": {
            "type": "string",
            "title": "Manager Id"
          },
          "notes": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Notes"
          }
        },
        "type": "object",
        "required": [
          "cluster_id",
          "scenario_id",
          "manager_id"
        ],
        "title": "SubmitRecommendationRequest"
      },
      "SubmitRecommendationResponse": {
        "properties": {
          "status": {
            "type": "string",
            "title": "Status"
          },
          "audit_reference_id": {
            "type": "string",
            "title": "Audit Reference Id"
          },
          "timestamp": {
            "type": "string",
            "title": "Timestamp"
          },
          "submitted_by": {
            "type": "string",
            "title": "Submitted By"
          },
          "scenario": {
            "type": "string",
            "title": "Scenario"
          },
          "summary": {
            "$ref": "#/components/schemas/SubmitSummary"
          }
        },
        "type": "object",
        "required": [
          "status",
          "audit_reference_id",
          "timestamp",
          "submitted_by",
          "scenario",
          "summary"
        ],
        "title": "SubmitRecommendationResponse"
      },
      "SubmitSummary": {
        "properties": {
          "grow_count": {
            "type": "integer",
            "title": "Grow Count"
          },
          "maintain_count": {
            "type": "integer",
            "title": "Maintain Count"
          },
          "swap_count": {
            "type": "integer",
            "title": "Swap Count"
          },
          "reduce_count": {
            "type": "integer",
            "title": "Reduce Count"
          },
          "guardrails_satisfied": {
            "type": "boolean",
            "title": "Guardrails Satisfied"
          }
        },
        "type": "object",
        "required": [
          "grow_count",
          "maintain_count",
          "swap_count",
          "reduce_count",
          "guardrails_satisfied"
        ],
        "title": "SubmitSummary"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    }
  }
}