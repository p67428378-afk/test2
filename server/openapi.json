        "properties": {
          "total_students": {
            "type": "integer",
            "title": "Total Students"
          },
          "attendance_rate": {
            "type": "number",
            "title": "Attendance Rate"
          },
          "absent_today": {
            "type": "integer",
            "title": "Absent Today"
          },
          "unexcused": {
            "type": "integer",
            "title": "Unexcused"
          },
          "trends": {
            "items": {
              "$ref": "#/components/schemas/TrendItem"
            },
            "type": "array",
            "title": "Trends"
          },
          "watchlist": {
            "items": {
              "$ref": "#/components/schemas/WatchlistItem"
            },
            "type": "array",
            "title": "Watchlist"
