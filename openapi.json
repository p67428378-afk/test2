        "properties": {
          "cluster_id": {
            "type": "string",
            "title": "Cluster Id",
            "default": "STV-CLUSTER-01"
          },
          "category": {
            "type": "string",
            "title": "Category",
            "default": "Snacks"
          },
          "sales_per_linear_ft": {
            "type": "number",
            "title": "Sales Per Linear Ft"
          },
          "sales_per_linear_foot": {
            "type": "number",
            "title": "Sales Per Linear Foot",
            "default": 142.5
          },
          "private_brand_mix_pct": {
            "type": "number",
            "title": "Private Brand Mix Pct"
          },
          "in_stock_rate_pct": {
            "type": "number",
            "title": "In Stock Rate Pct"
          },
          "shelf_capacity_utilization_pct": {
            "type": "number",
            "title": "Shelf Capacity Utilization Pct"
          },
          "updated_at": {
            "type": "string",
            "title": "Updated At"
          }
        },
        "type": "object",
        "required": [
          "sales_per_linear_ft",
          "private_brand_mix_pct",
          "in_stock_rate_pct",
          "shelf_capacity_utilization_pct",
          "updated_at"
