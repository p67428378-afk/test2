      "delete": {
        "tags": [
          "todos"
        ],
        "summary": "Delete Todo",
        "description": "Permanently delete a todo task.",
        "operationId": "delete_todo_api_v1_todos__id__delete",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
