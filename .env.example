# Environment variables for local development.
# Copy to .env and adjust values:  cp .env.example .env

# Database connection string
DATABASE_URL=sqlite:///./dems.db
# Secret key for JWT token signing
JWT_SECRET_KEY=dev-secret-change-in-production-dems-secure-key-2026
# Comma-separated list of allowed CORS origins
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173
# Read by the backend code (STORAGE_DIR)
STORAGE_DIR=/tmp/dems_storage
