            "type": "string",
            "format": "uuid",
            "title": "Id"
          },
          "amount": {
            "type": "number",
            "title": "Amount"
          },
          "payment_date": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ],
            "title": "Payment Date"
          },
          "status": {
            "type": "string",
            "title": "Status"
          }
        },
        "type": "object",
        "required": [
          "id",
          "amount",
          "status"
        ],
        "title": "BillingHistoryItem"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
