              }
            }
          }
        }
      }
    },
    "/api/v1/skus": {
      "get": {
        "tags": [
          "assortment"
        ],
        "summary": "Get Skus",
        "operationId": "get_skus_api_v1_skus_get",
        "parameters": [
          {
            "name": "search",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Search term",
              "title": "Search"
            },
            "description": "Search term"
          },
          {
            "name": "sort_by",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Column to sort by",
              "title": "Sort By"
            },
            "description": "Column to sort by"
          },
          {
            "name": "sort_order",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "asc or desc",
              "default": "asc",
              "title": "Sort Order"
            },
            "description": "asc or desc"
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/SKUResponse"
                  },
                  "title": "Response Get Skus Api V1 Skus Get"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
