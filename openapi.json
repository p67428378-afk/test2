        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "title": "Id"
          },
          "user_id": {
            "type": "string",
            "format": "uuid",
            "title": "User Id"
          },
          "box_size": {
            "type": "string",
            "title": "Box Size"
          },
          "frequency_weeks": {
            "type": "integer",
            "title": "Frequency Weeks"
          },
          "status": {
            "type": "string",
            "title": "Status"
          },
          "next_payment_date": {
            "type": "string",
            "format": "date-time",
            "title": "Next Payment Date"
          },
          "skip_next": {
            "type": "boolean",
