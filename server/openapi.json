      "get": {
        "summary": "Get Sku Performance",
        "operationId": "get_sku_performance_api_v1_skus_performance_get",
        "parameters": [
          {
            "name": "category",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "description": "Category filter",
              "default": "snacks",
              "title": "Category"
            },
            "description": "Category filter"
          },
          {
            "name": "cluster",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "description": "Cluster filter",
              "default": "small-town-value",
              "title": "Cluster"
            },
            "description": "Cluster filter"
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/SKUPerformanceResponse"
                  },
                  "title": "Response Get Sku Performance Api V1 Skus Performance Get"
                }
              }
            }
          },
          "422": {
