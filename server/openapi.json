            "type": "string",
            "format": "uuid",
            "title": "Student Id"
          },
          "student_name": {
            "type": "string",
            "title": "Student Name"
          },
          "total_days": {
            "type": "integer",
            "title": "Total Days"
          },
          "absences": {
            "type": "integer",
            "title": "Absences"
          },
          "lates": {
            "type": "integer",
            "title": "Lates"
          },
          "attendance_rate": {
            "type": "number",
            "title": "Attendance Rate"
          },
          "calendar": {
            "items": {
              "$ref": "#/components/schemas/CalendarItem"
            },
            "type": "array",
            "title": "Calendar"
