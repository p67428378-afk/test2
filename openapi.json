  "components": {
    "schemas": {
      "ActionSummary": {
        "properties": {
          "GROW": {
            "type": "integer",
            "title": "Grow",
            "default": 0
          },
          "MAINTAIN": {
            "type": "integer",
            "title": "Maintain",
            "default": 0
          },
          "SWAP": {
            "type": "integer",
            "title": "Swap",
            "default": 0
          },
          "REDUCE": {
            "type": "integer",
            "title": "Reduce",
            "default": 0
          }
        },
        "type": "object",
        "title": "ActionSummary"
      },
      "GuardrailItem": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "rule_name": {
            "type": "string",
            "title": "Rule Name"
          },
          "metric_key": {
            "type": "string",
            "title": "Metric Key"
          },
          "operator": {
            "type": "string",
            "title": "Operator"
          },
          "threshold_value": {
            "type": "number",
            "title": "Threshold Value"
          },
          "is_mandatory": {
            "type": "boolean",
            "title": "Is Mandatory",
            "default": true
          }
        },
        "type": "object",
        "required": [
          "id",
          "rule_name",
          "metric_key",
          "operator",
          "threshold_value"
