            "type": "string",
            "title": "Id"
          },
          "name": {
            "type": "string",
            "title": "Name"
          },
          "tenure_months": {
            "type": "integer",
            "title": "Tenure Months"
          },
          "interest_rate": {
            "type": "number",
            "title": "Interest Rate"
          },
          "min_deposit": {
            "type": "number",
            "title": "Min Deposit"
