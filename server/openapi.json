            "title": "Submission Id"
          },
          "status": {
            "type": "string",
            "title": "Status"
          },
          "scenario_selected": {
            "type": "string",
            "title": "Scenario Selected"
          },
          "actions_submitted_count": {
            "type": "integer",
            "title": "Actions Submitted Count"
          },
          "manager_email": {
            "type": "string",
            "title": "Manager Email"
          },
          "timestamp": {
            "type": "string",
            "format": "date-time",
            "title": "Timestamp"
