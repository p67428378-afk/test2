  "components": {
    "schemas": {
      "FeedbackCreate": {
        "properties": {
          "recommendation_id": {
            "type": "string",
            "minLength": 1,
            "title": "Recommendation Id"
          },
          "user_id": {
            "type": "string",
            "minLength": 1,
            "title": "User Id"
          },
          "feedback": {
            "type": "string",
            "pattern": "^(like|dislike)$",
            "title": "Feedback"
          }
        },
        "type": "object",
        "required": [
          "recommendation_id",
          "user_id",
          "feedback"
        ],
        "title": "FeedbackCreate"
      },
      "FeedbackResponse": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "recommendation_id": {
            "type": "string",
            "title": "Recommendation Id"
          },
          "feedback": {
            "type": "string",
            "title": "Feedback"
          },
          "status": {
            "type": "string",
            "title": "Status",
            "default": "updated"
