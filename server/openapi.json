{
  "openapi": "3.1.0",
  "info": {
    "title": "Tip Calculator API",
    "description": "Stateless Tip Calculator REST API providing calculation and splitting endpoints.",
    "version": "1.0.0"
  },
  "paths": {
    "/api/v1/calculate-tip": {
      "post": {
        "tags": [
          "Tip Calculator"
        ],
        "summary": "Calculate Tip and Split Totals",
        "description": "Calculates total tip, total bill, tip per person, and total per person based on bill amount, tip percentage, and number of people splitting.",
        "operationId": "compute_tip_endpoint_api_v1_calculate_tip_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/TipCalculationRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TipCalculationResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/health": {
      "get": {
        "tags": [
          "Health"
        ],
        "summary": "Health Check",
        "description": "Service health check endpoint.",
        "operationId": "health_check_health_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          }
        }
      }
    },
    "/api/v1/health": {
      "get": {
        "tags": [
          "Health"
        ],
        "summary": "Api Health Check",
        "description": "API versioned health check endpoint.",
        "operationId": "api_health_check_api_v1_health_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "TipCalculationRequest": {
        "properties": {
          "bill_amount": {
            "type": "number",
            "exclusiveMinimum": 0.0,
            "title": "Bill Amount",
            "description": "Total bill amount before tip. Must be greater than 0.0."
          },
          "tip_percentage": {
            "type": "number",
            "maximum": 100.0,
            "minimum": 0.0,
            "title": "Tip Percentage",
            "description": "Tip percentage between 0.0 and 100.0."
          },
          "num_people": {
            "type": "integer",
            "minimum": 1.0,
            "title": "Num People",
            "description": "Number of people splitting the bill. Must be an integer >= 1.",
            "default": 1
          }
        },
        "type": "object",
        "required": [
          "bill_amount",
          "tip_percentage"
        ],
        "title": "TipCalculationRequest",
        "description": "Request schema for tip calculation."
      },
      "TipCalculationResponse": {
        "properties": {
          "total_tip": {
            "type": "number",
            "title": "Total Tip",
            "description": "Total tip amount rounded to 2 decimal places."
          },
          "total_bill": {
            "type": "number",
            "title": "Total Bill",
            "description": "Total bill amount including tip, rounded to 2 decimal places."
          },
          "tip_per_person": {
            "type": "number",
            "title": "Tip Per Person",
            "description": "Tip amount owed per person, rounded to 2 decimal places."
          },
          "total_per_person": {
            "type": "number",
            "title": "Total Per Person",
            "description": "Total amount owed per person (bill + tip), rounded to 2 decimal places."
          }
        },
        "type": "object",
        "required": [
          "total_tip",
          "total_bill",
          "tip_per_person",
          "total_per_person"
        ],
        "title": "TipCalculationResponse",
        "description": "Response schema containing calculated tip and split breakdowns."
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    }
  }
}