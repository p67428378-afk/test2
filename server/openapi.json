{
  "openapi": "3.1.0",
  "info": {
    "title": "Simple Calculator API",
    "description": "Stateless REST API for basic mathematical calculations with precision arithmetic.",
    "version": "1.0.0"
  },
  "paths": {
    "/health": {
      "get": {
        "tags": [
          "health"
        ],
        "summary": "Health Check",
        "operationId": "health_check_health_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/calculate": {
      "post": {
        "tags": [
          "calculator"
        ],
        "summary": "Calculate",
        "operationId": "calculate_api_v1_calculate_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CalculationRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CalculationResponse"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request (e.g., Division by Zero)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "422": {
            "description": "Unprocessable Entity (Invalid Syntax)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "CalculationRequest": {
        "properties": {
          "expression": {
            "type": "string",
            "title": "Expression",
            "description": "Mathematical expression to evaluate",
            "examples": [
              "12 + 8"
            ]
          }
        },
        "type": "object",
        "required": [
          "expression"
        ],
        "title": "CalculationRequest"
      },
      "CalculationResponse": {
        "properties": {
          "result": {
            "type": "number",
            "title": "Result",
            "description": "Computed result"
          },
          "expression": {
            "type": "string",
            "title": "Expression",
            "description": "Original expression"
          },
          "status": {
            "type": "string",
            "title": "Status",
            "description": "Execution status",
            "default": "success"
          },
          "timestamp": {
            "type": "string",
            "title": "Timestamp",
            "description": "ISO 8601 timestamp"
          }
        },
        "type": "object",
        "required": [
          "result",
          "expression",
          "timestamp"
        ],
        "title": "CalculationResponse"
      },
      "ErrorResponse": {
        "properties": {
          "detail": {
            "type": "string",
            "title": "Detail",
            "description": "Error details"
          },
          "error_code": {
            "type": "string",
            "title": "Error Code",
            "description": "Standardized error code"
          }
        },
        "type": "object",
        "required": [
          "detail",
          "error_code"
        ],
        "title": "ErrorResponse"
      },
      "HealthResponse": {
        "properties": {
          "status": {
            "type": "string",
            "title": "Status",
            "description": "System health status",
            "default": "healthy"
          }
        },
        "type": "object",
        "title": "HealthResponse"
      }
    }
  }
}