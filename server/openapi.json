          "total_expense",
          "net_balance",
          "category_breakdown"
        ],
        "title": "AnalyticsSummary"
      },
      "BudgetCreate": {
        "properties": {
          "category_id": {
            "type": "string",
            "title": "Category Id"
          },
          "monthly_limit": {
            "type": "number",
            "exclusiveMinimum": 0.0,
            "title": "Monthly Limit",
            "description": "Monthly budget limit must be positive"
          },
          "month": {
            "type": "string",
            "pattern": "^\\d{4}-(0[1-9]|1[0-2])$",
            "title": "Month",
            "description": "Format: YYYY-MM"
          }
        },
        "type": "object",
        "required": [
          "category_id",
          "monthly_limit",
          "month"
        ],
        "title": "BudgetCreate"
      },
